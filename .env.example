# Get a key at https://platform.claude.com. Without one, the app runs in offline demo mode.
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
PORT=3001

# Optional: "AI enhance" for rendered views uses OpenAI's image edit API (Claude can't generate images).
# Leave empty to keep enhance switched off. The built-in renderer works without it.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
